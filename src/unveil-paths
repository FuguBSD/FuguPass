# unveil-paths - write the unveil list of the interface process.
#
# usage: unveil-paths > unveil_paths.h
#
# The build step of src/lib/Makefile runs this program, and
# src/sandbox.c reads the header that it writes (PROG-SPLIT-10). The
# list comes from Fugu::Sandbox->perl_lib_dirs and
# Fugu::Sandbox->system_paths, and the perl that runs this program
# gives the values. The interface process is a program of that perl,
# so the build of a machine derives the paths of that machine.
#
# Neither method calls a syscall, so t/fugupass/repl.t runs this
# program on the host and proves the header that it writes.

use v5.34;
use warnings;
use experimental 'signatures';
no feature qw(indirect multidimensional bareword_filehandles);

use Fugu::Sandbox;

# The name of the macro, and the include guard of the header.
use constant {
	MACRO => 'UNVEIL_PATHS_DERIVED',
	GUARD => 'UNVEIL_PATHS_H',
};

# The comment of the header. The reader of src/sandbox.c reaches it
# through the include, so it states where the values come from.
my @NOTE = (
	'The unveil list of the interface process (PROG-SPLIT-10).',
	'',
	'src/unveil-paths writes this file, and the build step of',
	'src/lib/Makefile runs that program. Do not edit this file, and',
	'do not commit it: each build writes it again.',
	'',
	'Fugu::Sandbox->perl_lib_dirs names the library directories of',
	'the perl of this build, and Fugu::Sandbox->system_paths names',
	'the random device, the resolver files, the service tables and',
	'the time zone file. src/sandbox.c holds the type of one row.'
);

# entries():
#	The unveil entries of the interface process, in order: the
#	library directories of the perl first, then the read-only
#	system paths. Each entry is a path and the permissions of that
#	path.
#
#	A perl can name one directory under two %Config keys, so the
#	list drops a repeated path. unveil(2) replaces rather than
#	merges the permissions of a path, and a repeated row of one
#	list therefore states the same value twice.
#
#	An entry of system_paths can carry the optional flag, and no
#	row of the header holds it. sandbox_enter() of src/sandbox.c
#	takes ENOENT of every row of its list, so an absent path of
#	this list stops no run.
sub entries ()
{
	my @entry = map { [ $_, 'r' ] } Fugu::Sandbox->perl_lib_dirs;
	push @entry, map { [ $_->[0], $_->[1] ] } Fugu::Sandbox->system_paths;

	my ( @out, %seen );
	for my $entry (@entry) {
		push @out, $entry if !$seen{ $entry->[0] }++;
	}
	return @out;
}

# rows(@entry):
#	One initializer row of src/sandbox.c for each entry, with the
#	line continuation of the macro after each row but the last
#	one.
#
#	A path with a double quote or a backslash in it would leave
#	the string literal of the row, and no library directory of a
#	perl holds one. The call dies on such a path.
sub rows (@entry)
{
	die "unveil-paths: the list holds no path\n" if !@entry;

	my @row;
	for my $entry (@entry) {
		my ( $path, $perms ) = @$entry;
		die "unveil-paths: the path $path holds a quote\n"
		    if $path =~ /["\\]/;
		die "unveil-paths: the permissions of $path are '$perms'\n"
		    if $perms !~ /\A[rwxc]+\z/;
		push @row, "\t{ \"$path\",\t\"$perms\" }";
	}

	my $last = pop @row;
	return ( map { "$_,\t\\" } @row ), $last;
}

# header(@entry):
#	The text of the header that holds the entries @entry. The
#	macro expands to the initializer rows of the unveil list of
#	src/sandbox.c, so that file holds the type and this file holds
#	the paths.
sub header (@entry)
{
	my @line = ( '/*', map { length ? " * $_" : ' *' } @NOTE );
	push @line, ' */', '', "#ifndef ${\ GUARD }", "#define ${\ GUARD }",
	    '', "#define ${\ MACRO }\t\\", rows(@entry), '',
	    "#endif /* ${\ GUARD } */";

	return join '', map { "$_\n" } @line;
}

print header( entries() ) or die "unveil-paths: $!\n";

exit 0;
