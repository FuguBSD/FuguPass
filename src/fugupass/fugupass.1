.Dd $Mdocdate: October 27 2026 $
.Dt FUGUPASS 1
.Os
.Sh NAME
.Nm fugupass
.Nd FuguPass vault core
.Sh SYNOPSIS
.Nm
.Op Fl d Ar directory
.Nm
.Op Fl d Ar directory
.Cm create
.Fl k Ar threshold
.Fl m Ar machine
.Fl r Ar rounds
.Op Fl p Ar slots
.Ar oracle ...
.Nm
.Op Fl d Ar directory
.Cm canary
.Ar oracle
.Nm
.Op Fl d Ar directory
.Cm passwd
.Nm
.Op Fl d Ar directory
.Cm resume
.Nm
.Op Fl d Ar directory
.Cm refill
.Nm
.Op Fl d Ar directory
.Cm provision
.Op Fl a
.Fl k Ar threshold
.Fl m Ar machine
.Fl r Ar rounds
.Ar oracle ...
.Nm
.Op Fl d Ar directory
.Cm kit
.Op Fl m Ar machine
.Nm
.Op Fl d Ar directory
.Cm revoke
.Op Fl r
.Fl m Ar machine
.Op Ar position ...
.Nm
.Op Fl d Ar directory
.Cm recover
.Op Fl w
.Op Fl \-ceiling Ar ceiling
.Nm
