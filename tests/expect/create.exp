#!/usr/bin/expect -f
#
# Answer the two passphrase prompts of a ceremony on the console of
# the guest (TEST-HARNESS-8, CER-CREATE-4).
#
# Usage: create.exp <host> <port> <command> <pass> <pass> [password]
#         [user]
#
# fuguvm expect prepends the host and the port, so the caller gives
# the arguments after them. The command runs one shell script of the
# guest, and that script writes the exit status of the ceremony to a
# file. An expect script reports its own run alone, so the caller
# reads that file over fuguvm ssh.
#
# The console of the guest needs a login. fuguvm generates the root
# password of an installation, and it keeps that password in the
# state of the guest, so the caller gives the value here. The
# default is the default of the installer.
#
# fuguvm ssh runs through libssh2 channel->exec, and that channel
# carries no terminal. readpassphrase(3) reads /dev/tty, so a
# ceremony needs this console.

# Use the environment variable when it exists. Otherwise use 600.
# A ceremony enrolls one record for each slot of the pool, so it
# runs for minutes.
if {[info exists env(FUGUVM_TIMEOUT)]} {
    set timeout $env(FUGUVM_TIMEOUT)
} else {
    set timeout 600
}

if {[llength $argv] < 5} {
    puts stderr "Usage: create.exp <host> <port> <command> <pass> <pass>"
    exit 1
}

set host [lindex $argv 0]
set port [lindex $argv 1]
set cmd [lindex $argv 2]
set first [lindex $argv 3]
set second [lindex $argv 4]
set password [lindex $argv 5]
set user [lindex $argv 6]

if {$password eq ""} {
    set password "openbsd"
}
if {$user eq ""} {
    set user "root"
}

spawn telnet $host $port

# A newline brings the login prompt or the shell prompt.
send "\r"

expect {
    "login:" {
        send "$user\r"
        expect "Password:"
        send "$password\r"
    }
    "#" {
        # The console already holds a shell. This block takes the
        # one prompt of it, so the newline below gives the prompt
        # that the next block reads.
        send "\r"
    }
    eof {
        puts stderr "telnet could not connect to the console"
        exit 1
    }
    timeout {
        puts stderr "no login prompt and no shell prompt"
        exit 1
    }
}

expect {
    "#" {
        send "$cmd\r"
    }
    timeout {
        puts stderr "no shell prompt for the command"
        exit 1
    }
}

expect {
    "Passphrase:" {
        send "$first\r"
    }
    timeout {
        puts stderr "no first passphrase prompt"
        exit 1
    }
}

expect {
    "Passphrase again:" {
        send "$second\r"
    }
    timeout {
        puts stderr "no second passphrase prompt"
        exit 1
    }
}

# The script of the guest writes every other byte to a file, so the
# next shell prompt marks the end of the ceremony.
expect {
    "#" {
        send "exit\r"
    }
    timeout {
        puts stderr "the ceremony did not reach the shell prompt"
        exit 1
    }
}

expect {
    "login:" {}
    timeout {}
}

exit 0
