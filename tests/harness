# harness: run the record legs against every available counterparty.
#
# usage: make harness
#
# This program is the interop harness of TEST-HARNESS. It is no .t
# file, and make check never runs it: it needs a live counterparty
# and an OpenBSD guest. mk/local.mk holds the harness target, and
# that target is the one caller.
#
# The harness holds three parts. The first part builds the source in
# the guest, and it takes the driver src/regress/oracle-client of
# that build (TEST-HARNESS-7). The second part is the counterparty
# table below: one data record for each counterparty, with the
# probe, the start, the stop, the release and the record list of it
# (TEST-HARNESS-4, TEST-HARNESS-6). The third part is
# tests/harness.d, one file for each leg. A leg reads the
# counterparty through the methods of the Counterparty package
# alone, so no leg branches on the counterparty (TEST-HARNESS-4).
#
# One counterparty runs $INSTANCES instances, and each instance is
# one oracle of a topology. The example topology of TEST-HARNESS-5
# takes three of them, with a threshold of two. The start, the stop
# and the release of the table each take one instance, so every
# instance holds a record store and a port of its own
# (TEST-HARNESS-6).
#
# The harness runs no shell on the host: each host command is a
# list, and Fugu::Process runs it (TEST-HARNESS-6). A guest command
# goes through 'fuguvm ssh -- sh -c <script>', because a guest step
# needs a redirect and a pipe. That argument vector is a list as
# well, and App::FuguVM::Remote quotes each word of it. fuguvm gives
# the guest no standard input, so the driver reads the passphrase
# from a pipe of the guest shell.
#
# Every command of the core process reads the passphrase from
# /dev/tty, and the ssh channel of fuguvm carries no terminal. Such
# a command therefore runs on the serial console, under 'fuguvm
# expect' and the script tests/expect/console.exp (TEST-HARNESS-8).
# An expect script reports its own run alone, so the script of the
# guest writes the exit status of each step to a file, and the
# harness reads those files over 'fuguvm ssh'. A secret prints to
# the terminal, so the console text of a step carries it, and no
# file of the step holds one (PROG-OUTPUT-1, PROG-OUTPUT-4).
#
# The plate scan of a ceremony takes the double
# tests/stubs/fugupass-scan.c, and that double prints the fixed test
# master. tests/vectors/derive.h holds that value as a C constant,
# so the double is a C program and the guest build compiles it
# (TEST-KAT-4). The core process reads the helper directory from
# FUGUPASS_HELPERS in a regress build alone, so the guest build runs
# 'make FUGUPASS_REGRESS=1' (PROG-SPLIT-11).
#
# The render helper takes no double: the guest build makes
# fugupass-qr, and the helper directory holds that program. A
# mnemonic entry prints as the QR code of it (PROG-OUTPUT-2). The
# scan helper of the build stands in a directory of its own, and a
# leg names that directory for a ceremony with the real camera path
# (PROG-SCAN-7).
#
# The harness fails when no counterparty is available. A pass over
# zero legs is no pass.
#
# The interface process is Perl on the Fugu library, and the build
# step of src/lib derives the unveil list of that process from
# Fugu::Sandbox (PROG-SPLIT-7, PROG-SPLIT-10). build_guest()
# therefore installs the Fugu library of the host into the guest
# before the build, and it installs bin/fugupass-repl into the
# helper directory after it.
#
# The harness builds the tree of HEAD in the guest, and it runs the
# legs of the working tree. git status of bin, src and tests must
# therefore report no change, and no untracked file. A local build
# leaves an obj directory that no ignore rule covers, so remove it
# before a run.
#
# These are the environment variables:
#
#	FUGUPASS_BLIND_PIN_SERVER
#		The directory of a checkout of the upstream
#		blind_pin_server, with a Python environment at
#		venv of that directory. The name of the directory
#		must stay blind_pin_server, because the start
#		recipe imports that module. Build the environment
#		on Python 3.13: the pinned wallycore publishes no
#		wheel for Python 3.14, and a source build of it
#		needs autotools. The command is 'uv pip install
#		--require-hashes -r requirements.txt'. The
#		location of a checkout of a third-party server is
#		no design fact of FuguPass, so no document of
#		spec/ names this variable.
#
#	FUGUVM	The fuguvm command. The default is fuguvm of the
#		PATH. fuguvm needs the modules of FuguVM and the
#		agent socket of the guest, so the caller sets
#		PERL5LIB and SSH_AUTH_SOCK for it.
#
#	FUGUPASS_CONSOLE_PASSWORD
#		The root password of the console login of the
#		guest. The default is openbsd, the password of the
#		installer of fuguvm. An installation of the mode
#		expect generates a password of 32 characters and
#		keeps it in the state of the guest, so the operator
#		reads that value and gives it here. fuguvm gives no
#		command for it, and no status key holds it. The
#		password of a disposable test guest is no design
#		fact of FuguPass, so no document of spec/ names this
#		variable.
#
# The harness runs the legs against every available conforming
# counterparty (TEST-HARNESS-1). The upstream blind_pin_server is the
# one counterparty today (TEST-HARNESS-2). The FuguOracle leg is
# absent, and no FuguOracle service speaks HTTP. That leg needs a
# FuguOracle deployment, and it then becomes one entry of the
# counterparty table.

use v5.36;

use Cwd              qw(abs_path);
use File::Basename   qw(basename dirname);
use File::Path       qw(make_path remove_tree);
use File::Temp       ();
use FindBin          qw($RealBin);
use HTTP::Tiny       ();
use IO::Socket::INET ();
use Test::More;

use Fugu::Process;
use Fugu::Timeout;

# The legs read these values through the Counterparty package, so
# each one is a package variable of main.

# The work directory of the guest. It sits on /home, because the
# root partition of the guest holds a few hundred megabytes only,
# and a build of this tree fills it.
our $WORK = '/home/fugupass/harness';

# The tree of the guest build, the driver that it builds, and the
# core process that it builds.
our $TREE    = "$WORK/tree";
our $DRIVER  = "$TREE/src/regress/obj/oracle-client";
our $PROGRAM = "$TREE/src/fugupass/obj/fugupass";

# The directory of the helper programs of a leg, and the run
# directory of one ceremony. FUGUPASS_HELPERS names the first one,
# and the three helper paths are that directory and the three file
# names (PROG-SPLIT-11). That directory holds the scan double, the
# render helper of the build and the interface program.
our $HELPERS = "$WORK/helpers";
our $RUN     = "$WORK/run";

# The directory of the real scan helper. A leg names it in place of
# $HELPERS, and a ceremony of that directory opens a video device
# (PROG-SCAN-7). The two other helper paths of that directory hold
# no file, and the unveil list of the core passes over an absent
# path (PROG-SPLIT-3).
our $REAL = "$WORK/real";

# The fixed values of a test vault: the first slot index, the
# 1-based position of the oracle list, the machine name of the
# config, and the round count of the pin secret. A small round count
# keeps the cost of a leg in the request, and not in the KDF.
#
# The client key of a record takes the device factor, the oracle
# index and the slot index (KEY-CLIENT-1). The device factor takes
# the fixed test master and the machine name, so two vaults of one
# slot address one record at the counterparty. Each vault of a run
# therefore takes the next slot index, and one leg destroys no
# record of another leg.
our $SLOT    = 7;
our $ORACLE  = 1;
our $MACHINE = 'testmachine';
our $ROUNDS  = 16;

# The string constants of tests/vectors/derive.h, by name. The scan
# double prints KAT_TEST_MASTER, so a ceremony of a leg runs under
# the fixed test master (TEST-KAT-4). The header is the one place
# that holds the value of each constant.
our %VECTOR = vectors("$RealBin/vectors/derive.h");

# The answers of the legs, by name: the passphrases, and the
# secrets that a console step types. A leg names one of these keys,
# and it holds no value of its own. Each value holds no single quote
# and no line feed, and _shq() guards that.
#
# The totp key is the key of the RFC 6238 test vector, as the hex of
# the twenty ASCII bytes 12345678901234567890 (ENTRY-TYPES-3).
#
# The answer 'none' is the empty line. The core process takes an
# empty read of readpassphrase(3) as a failed read, so a step names
# this answer to stop a terminal read.
#
# The answers 'yes' and 'no' are the two answers of a confirmation.
# The core process takes the word yes alone, so 'no' stops a
# ceremony at the confirmation (CER-PROVISION-3).
our %ANSWER = (
	right    => 'correct horse battery staple',
	wrong    => 'wrong horse battery staple',
	other    => 'other horse battery staple',
	none     => '',
	yes      => 'yes',
	no       => 'no',
	secret   => 'the stored secret of one entry',
	secret2  => 'the second stored secret of one entry',
	totp_key => '3132333435363738393031323334353637383930' );

# The generator point of secp256k1, in compressed form. It is a
# valid public key, and it is the static key of no oracle. A leg
# gives it to the config to state a wrong static key
# (ORC-PROVISION-1).
our $FOREIGN_POINT =
    '0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798';

# A stored counter above the wall clock, for the legs of the counter
# policy. The value stays below 0xFFFFFFFF, because the client sends
# the stored value plus one, and it never sends 0xFFFFFFFF
# (ORC-COUNTER-5).
our $HIGH_COUNTER = 4_000_000_000;

our $FUGUVM = $ENV{FUGUVM} // 'fuguvm';

# The expect script of the console. fuguvm expect gives it the host
# and the port of the console first, and the script needs the
# execute bit (TEST-HARNESS-8).
our $EXPECT = "$RealBin/expect/console.exp";

# The instances of one counterparty. The example topology of
# TEST-HARNESS-5 holds three oracles, so a run starts three.
our $INSTANCES = 3;

# The step marker of a console session. The script of the guest
# echoes it before each step, and it echoes the step 0 of it last.
# console.exp waits for that last line, so a shell prompt of an
# earlier line ends no run.
our $STEP_MARK = '=== fugupass-console-step';

# The clock of one step. console() reads it before the step and
# after it, and elapsed() gives the difference of the two reads.
# date(1) reads whole seconds, so each read of it loses up to one
# second and a difference of two reads loses up to two. Time::HiRes
# is a core module of the guest, and it loses under a millisecond.
our $CLOCK = q{perl -MTime::HiRes=time -e 'printf "%.6f\n", time'};

# The root password of the console login of the guest.
our $CONSOLE_PASSWORD = $ENV{FUGUPASS_CONSOLE_PASSWORD} // 'openbsd';

# The seconds of one guest command, and of one build of the tree.
my $GUEST_TIMEOUT = 300;
my $BUILD_TIMEOUT = 1800;

# The seconds of one ceremony on the console. A ceremony enrolls one
# record for each slot of the pool. The expect script reads the same
# value from FUGUVM_TIMEOUT, and it gives up before this timeout.
our $CONSOLE_TIMEOUT = 1500;
$ENV{FUGUVM_TIMEOUT} = $CONSOLE_TIMEOUT - 60;

# The start recipe of the upstream server. The Python of the
# checkout runs this program, and the first argument is the record
# store of the run. flask_server() reads the private key, the public
# key and the pins directory of the working directory, so the
# program enters the store before it imports the module.
# Fugu::Process->spawn_command() sets no working directory, and a
# shell is not allowed, so the chdir lives here.
my $SERVER_PROGRAM = <<'PYTHON';
import os, sys
os.chdir(sys.argv[1])
from blind_pin_server.flaskserver import flask_server
flask_server().run(host=sys.argv[2], port=int(sys.argv[3]))
PYTHON

# The counterparties that this harness drives (TEST-HARNESS-2). Each
# record holds the name, the four steps of the run, and the record
# list of a store. probe() takes the counterparty, and it gives
# undef when the counterparty is available, and the reason when it
# is not. start(), stop(), release() and records() each take the
# counterparty and one instance of it. start() sets url, pubkey and
# records_at_start of that instance, and records() gives the record
# file names of the store of that instance of the moment. A leg
# reads no member of this table.
my @COUNTERPARTY = (
	{
		name    => 'blind_pin_server',
		probe   => \&upstream_probe,
		start   => \&upstream_start,
		stop    => \&upstream_stop,
		release => \&upstream_release,
		records => \&upstream_records,
		wipe    => \&upstream_wipe
	} );

# The counterparties that run now. The end block stops each one, so
# a die and a signal leave no server behind, and no record store.
my @RUNNING;

# vectors($path):
#	The string constants of the vector header $path, by name.
#	The header holds one #define of each constant, and a
#	constant of more than one line joins with a backslash. A
#	#define of another form takes no entry.
sub vectors ($path)
{
	open my $fh, '<', $path or die "the harness reads no $path: $!\n";
	my $text = do { local $/ = undef; <$fh> };
	close $fh;

	$text =~ s/\\\n//g;
	my %value;
	while ( $text =~ /^\#define\s+(\w+)\s+(.*)$/mg ) {
		my ( $name, $rest ) = ( $1, $2 );
		my @part = $rest =~ /"([^"]*)"/g;
		$value{$name} = join '', @part if @part;
	}
	die "$path holds no string constant\n" if !%value;
	return %value;
}

# _shq($word):
#	One word for the shell of the guest, in single quotes. The
#	word must hold no single quote and no line feed. A leg
#	writes a literal path and a named passphrase, so a word of
#	another shape is a programming error.
sub _shq ($word)
{
	die "the harness cannot quote the word $word\n" if $word =~ /['\n]/;
	return "'$word'";
}

# guest($script, $timeout):
#	Run one shell script in the guest, and give the result hash
#	of Fugu::Process->run(). The host command is a list, and the
#	script is one word of it.
sub guest ( $script, $timeout = $GUEST_TIMEOUT )
{
	return Fugu::Process->run(
		cmd     => [ $FUGUVM, 'ssh', '--', 'sh', '-c', $script ],
		timeout => $timeout );
}

# guest_script($name, @lines):
#	Write the shell script @lines to the run directory of the
#	guest, and give the path of it. The copy takes 'fuguvm put',
#	so a line needs no quoting for the shell of the guest.
sub guest_script ( $name, @lines )
{
	my $file = File::Temp->new(
		TEMPLATE => 'fugupass-script-XXXXXX',
		TMPDIR   => 1,
		SUFFIX   => '.sh' );
	print {$file} map { "$_\n" } @lines
	    or die "the harness wrote no script: $!\n";
	close $file or die "the harness closed no script: $!\n";

	my $path = "$RUN/$name";
	guest_ok( 'the run directory', "mkdir -p $RUN" );
	host_ok( 'fuguvm put', [ $FUGUVM, 'put', "$file", $path ],
		timeout => $GUEST_TIMEOUT );
	return $path;
}

# guest_ok($what, $script, $timeout):
#	Run one shell script in the guest, and die when it fails.
#	The call gives the standard output of the script, and $what
#	names the step in the message.
sub guest_ok ( $what, $script, $timeout = $GUEST_TIMEOUT )
{
	my $result = guest( $script, $timeout );
	return $result->{stdout} if ( $result->{exit_code} // -1 ) == 0;

	die "the guest failed at $what: "
	    . ( $result->{error} // 'exit ' . ( $result->{exit_code} // -1 ) )
	    . "\n$result->{stdout}$result->{stderr}";
}

# host_ok($what, $cmd, %args):
#	Run one host command, and die when it fails. %args goes to
#	Fugu::Process->run().
sub host_ok ( $what, $cmd, %args )
{
	my $result = Fugu::Process->run( cmd => $cmd, %args );
	return $result->{stdout} if $result->{success};

	die "the host failed at $what: "
	    . ( $result->{error} // 'exit ' . ( $result->{exit_code} // -1 ) )
	    . "\n$result->{stdout}$result->{stderr}";
}

# free_port():
#	A TCP port that no program holds now. The guest reaches the
#	host at the QEMU gateway address, so a host counterparty
#	binds every address of the host (TEST-HARNESS-7).
sub free_port ()
{
	my $socket = IO::Socket::INET->new(
		Listen    => 1,
		LocalAddr => '127.0.0.1',
		Proto     => 'tcp'
	) or die "the host holds no free port: $!\n";
	my $port = $socket->sockport;
	$socket->close;
	return $port;
}

# build_guest($root):
#	Build the source of the checkout $root in the guest, and
#	leave the driver at $DRIVER (TEST-HARNESS-7).
#
#	git archive writes the committed tree of bin, src and tests,
#	so the copy needs no file list. A hand-written list of files
#	goes stale, and a stale list hides a defect behind a green
#	gate.
#
#	The build therefore takes HEAD, and load_legs() takes the
#	legs of the working tree. One tree must be under test, so a
#	change of one of the three directories that no commit holds
#	stops the run.
sub build_guest ($root)
{
	my @dir = qw(bin src tests);

	my $dirty = host_ok(
		'git status',
		[ 'git', 'status', '--porcelain', '--', @dir ],
		cwd     => $root,
		timeout => $GUEST_TIMEOUT );
	die "the harness builds HEAD, and "
	    . join( ', ', @dir )
	    . " holds a change that no commit holds. Commit the change, "
	    . "or remove the file. An untracked file counts, and no "
	    . "ignore rule covers the obj directory of a build:\n$dirty"
	    if $dirty =~ /\S/;

	my $tar = File::Temp->new(
		TEMPLATE => 'fugupass-tree-XXXXXX',
		TMPDIR   => 1,
		SUFFIX   => '.tar'
	);
	host_ok(
		'git archive',
		[
			'git', 'archive', '--format=tar', '-o', "$tar",
			'HEAD', @dir
		],
		cwd     => $root,
		timeout => $GUEST_TIMEOUT );

	guest_ok( 'the work directory', "rm -rf $WORK && mkdir -p $TREE" );
	host_ok(
		'fuguvm put',
		[ $FUGUVM, 'put', "$tar", "$WORK/tree.tar" ],
		timeout => $GUEST_TIMEOUT );
	guest_ok( 'the unpack', "cd $TREE && tar xf $WORK/tree.tar" );

	# The Fugu library comes before the build: src/unveil-paths
	# reads Fugu::Sandbox at build time (PROG-SPLIT-10).
	fugu_library();

	guest_ok( 'the build',
		"cd $TREE/src && make obj && make FUGUPASS_REGRESS=1",
		$BUILD_TIMEOUT );
	guest_ok( 'the driver',  "test -x $DRIVER" );
	guest_ok( 'the program', "test -x $PROGRAM" );

	# The doubles and the programs of the helper directory. The
	# core process runs each one from the directory that
	# FUGUPASS_HELPERS names (PROG-SPLIT-11). The scan double
	# reads the vectors of the tree above, and the interface
	# program is the one helper that the repository ships whole
	# (PROG-SPLIT-1).
	guest_ok(
		'the scan double',
		"mkdir -p $HELPERS $RUN && cc -Wall -Wextra -Werror "
		    . "-I$TREE/tests -o $HELPERS/fugupass-scan "
		    . "$TREE/tests/stubs/fugupass-scan.c" );
	guest_ok(
		'the interface program',
		"cp $TREE/bin/fugupass-repl $HELPERS/fugupass-repl && "
		    . "chmod 0755 $HELPERS/fugupass-repl" );

	# The render helper of the build, beside the double above. A
	# mnemonic entry takes the QR code of that program
	# (PROG-OUTPUT-2), and the harness holds no double of it.
	guest_ok( 'the render helper',
		"cp $TREE/src/fugupass-qr/obj/fugupass-qr "
		    . "$HELPERS/fugupass-qr" );

	# The scan helper of the build, in a directory of its own.
	# The double above stands in the helper directory of every
	# leg, so a leg that needs the camera path names this one
	# (PROG-SCAN-7).
	guest_ok( 'the scan helper',
		"mkdir -p $REAL && cp $TREE/src/fugupass-scan/obj/"
		    . "fugupass-scan $REAL/fugupass-scan" );
	return;
}

# fugu_library():
#	Install the Fugu library of this host into the guest
#	(PROG-SPLIT-7). bin/fugupass-repl is Perl on that library,
#	and src/unveil-paths reads Fugu::Sandbox at build time
#	(PROG-SPLIT-10).
#
#	The host runs this harness on Fugu::Process, so 'make deps'
#	already installed the library here, and %INC names the tree
#	of it. The guest therefore takes the one tree that the host
#	proves, and no second download can disagree with it. The
#	OpenBSD port takes devel/p5-Fugu instead (PROG-PORT-3).
#
#	The library is pure Perl, so the copy needs no build. It goes
#	to the site directory of the guest perl, which
#	Fugu::Sandbox->system_paths does not name and
#	Fugu::Sandbox->perl_lib_dirs does.
sub fugu_library ()
{
	my $tree = $INC{'Fugu/Process.pm'}
	    or die "the harness runs without the Fugu library\n";
	my $dir = dirname($tree);
	my $at  = dirname($dir);

	my $tar = File::Temp->new(
		TEMPLATE => 'fugupass-fugu-XXXXXX',
		TMPDIR   => 1,
		SUFFIX   => '.tar'
	);
	host_ok(
		'tar of the Fugu library',
		[ 'tar', '-C', $at, '-cf', "$tar", basename($dir) ],
		timeout => $GUEST_TIMEOUT );
	host_ok(
		'fuguvm put',
		[ $FUGUVM, 'put', "$tar", "$WORK/fugu.tar" ],
		timeout => $GUEST_TIMEOUT );

	my $site = guest_ok( 'the site directory of the guest perl',
		q{perl -MConfig -e 'print $Config{sitelibexp}'} );
	chomp $site;
	die "the guest perl names no site directory\n" if $site !~ m{\A/\S+\z};

	guest_ok( 'the Fugu library',
		"rm -rf $site/Fugu && mkdir -p $site && "
		    . "tar xf $WORK/fugu.tar -C $site" );
	guest_ok( 'the load of the Fugu library',
		'perl -MFugu::Sandbox -e 1' );
	return;
}

# leg_order($file):
#	The number that the file name of one leg starts with. A
#	string sort puts the leg 10 before the leg 2, so load_legs()
#	sorts the files on this value.
sub leg_order ($file)
{
	return basename($file) =~ /\A([0-9]+)-/ ? $1 + 0 : 0;
}

# load_legs():
#	The legs of tests/harness.d, in the order of the leg number.
#	Each file returns one code reference, and the harness calls
#	it once for each counterparty. A directory without a leg is
#	a failure: the harness must not pass over zero legs.
sub load_legs ()
{
	my @legs;
	for my $file (
		sort { leg_order($a) <=> leg_order($b) }
		glob "$RealBin/harness.d/*.pl" )
	{
		my $run = do $file;
		die "$file returns no leg: $@$!\n" if ref $run ne 'CODE';
		my $name = basename( $file, '.pl' );
		$name =~ s/\A[0-9]+-//;
		push @legs, { name => $name, run => $run };
	}
	die "tests/harness.d holds no leg\n" if !@legs;
	return @legs;
}

#
# The upstream Python counterparty. It runs on the host, and the
# client of the guest reaches it at the QEMU gateway address
# (TEST-HARNESS-7).
#

# upstream_python($checkout):
#	The interpreter and the environment of the checkout. The
#	module name is blind_pin_server, so PYTHONPATH names the
#	directory above the checkout. The child writes no byte code,
#	because the checkout belongs to the operator.
sub upstream_python ($checkout)
{
	return (
		"$checkout/venv/bin/python",
		{
			PATH                    => '/usr/bin:/bin',
			HOME                    => $ENV{HOME} // '/',
			PYTHONPATH              => dirname($checkout),
			PYTHONDONTWRITEBYTECODE => '1'
		} );
}

sub upstream_probe ($cp)
{
	my $checkout = $ENV{FUGUPASS_BLIND_PIN_SERVER};
	return 'FUGUPASS_BLIND_PIN_SERVER names no directory'
	    if !defined $checkout || !-d $checkout;
	return "$checkout does not carry the name blind_pin_server"
	    if basename($checkout) ne 'blind_pin_server';
	return "$checkout holds no flaskserver.py"
	    if !-f "$checkout/flaskserver.py";
	return "$checkout/venv/bin/python is no program"
	    if !-x "$checkout/venv/bin/python";

	my ( $python, $env ) = upstream_python($checkout);
	my $result = Fugu::Process->run(
		cmd     => [ $python, '-c', 'import flask, wallycore' ],
		env     => $env,
		timeout => 120 );
	return "$checkout/venv holds no flask and no wallycore"
	    if !$result->{success};

	$cp->{checkout} = $checkout;
	return undef;
}

sub upstream_start ( $cp, $in )
{
	my ( $python, $env ) = upstream_python( $cp->{checkout} );

	if ( !defined $in->{store} ) {

		# The record store of the run (TEST-HARNESS-6,
		# TEST-MASK-6). pindb.py takes the store from the
		# pins directory of the working directory, and the
		# server reads its static key from that directory
		# as well.
		$in->{store} = File::Temp::tempdir(
			'fugupass-oracle-XXXXXX',
			TMPDIR  => 1,
			CLEANUP => 0
		);
		make_path("$in->{store}/pins");
		$in->{port} = free_port();
		$in->{url}  = "http://10.0.2.2:$in->{port}";

		# generateserverkey writes the key pair at mode
		# 0600 in the working directory, and the server
		# refuses a key that another user can read.
		host_ok(
			'generateserverkey',
			[
				$python, '-m',
				'blind_pin_server.generateserverkey'
			],
			cwd     => $in->{store},
			env     => $env,
			timeout => 120 );

		open my $fh, '<:raw', "$in->{store}/server_public_key.pub"
		    or die "the server wrote no public key: $!\n";
		my $bytes = do { local $/ = undef; <$fh> };
		close $fh;
		$in->{pubkey} = unpack 'H*', $bytes;
	}

	# Each stream of each run takes a path of its own. Two
	# handles on one path overwrite each other, and 3-states.pl
	# restarts the server.
	my $log = "$in->{store}/server-" . ++$in->{runs};
	my $result = Fugu::Process->spawn_command(
		cmd => [
			$python,   '-c', $SERVER_PROGRAM, $in->{store},
			'0.0.0.0', $in->{port}
		],
		env    => $env,
		stdout => "$log.out",
		stderr => "$log.err" );
	die "the upstream server did not start: $result->{error}\n"
	    if !$result->{success};
	$in->{pid} = $result->{pid};

	my $http = HTTP::Tiny->new( timeout => 5 );
	Fugu::Timeout::wait_until(
		60, 0.25,
		sub {
			return $http->get("http://127.0.0.1:$in->{port}/")
			    ->{status} == 200;
		} )
	    or die "the upstream server never answered on port "
	    . "$in->{port}\n";

	$in->{records_at_start} //=
	    scalar( () = upstream_records( $cp, $in ) );
	return;
}

# upstream_records($cp, $in):
#	The record file names of the store of this instance.
#	pindb.py of the upstream server holds one file of each
#	record in the pins directory of the store.
sub upstream_records ( $, $in )
{
	return map { basename($_) } glob "$in->{store}/pins/*.pin";
}

# upstream_wipe($cp, $in, $name):
#	Remove the record file $name of the store of this instance
#	(REC-WIPE-6). The store holds one file of each record in the
#	pins directory, and $name is one file name of
#	upstream_records().
sub upstream_wipe ( $, $in, $name )
{
	my $path = "$in->{store}/pins/$name";
	unlink $path or die "the harness removed no record $path: $!\n";
	return;
}

sub upstream_stop ( $, $in )
{
	return if !defined $in->{pid};
	Fugu::Process->terminate( delete $in->{pid} );
	return;
}

sub upstream_release ( $, $in )
{
	return if !defined $in->{store};
	remove_tree( delete $in->{store} );
	return;
}

package Counterparty;

# The counterparty of one run. A leg reads it through these methods
# alone, so no leg branches on the counterparty (TEST-HARNESS-4).
# The record of the table holds the four steps and the record list,
# and each instance holds the state of one oracle: the URL, the
# static public key, and the record count of the store at the start.

use v5.36;

sub new ( $class, $recipe )
{
	return bless {
		recipe   => $recipe,
		name     => $recipe->{name},
		instance => [ map { {} } 1 .. $main::INSTANCES ]
	}, $class;
}

sub name ($self) { return $self->{name} }

sub probe ($self) { return $self->{recipe}{probe}->($self) }

# $cp->start, $cp->stop, $cp->release:
#	Every instance of this counterparty. start_oracle() and
#	stop_oracle() each take the position of one instance
#	(ORC-QUORUM-6).
sub start ($self)
{
	$self->start_oracle($_) for 1 .. @{ $self->{instance} };
	return;
}

sub stop ($self)
{
	$self->stop_oracle($_) for 1 .. @{ $self->{instance} };
	return;
}

sub release ($self)
{
	$self->{recipe}{release}->( $self, $_ ) for @{ $self->{instance} };
	return;
}

sub start_oracle ( $self, $oracle )
{
	$self->{recipe}{start}->( $self, $self->_instance($oracle) );
	return;
}

sub stop_oracle ( $self, $oracle )
{
	$self->{recipe}{stop}->( $self, $self->_instance($oracle) );
	return;
}

# $cp->_instance($oracle):
#	The instance of one position of the oracle list. A topology
#	can hold more positions than the run holds instances, and the
#	positions then take the instances in turn: position 4 of
#	three instances sits at the first one. Each position holds a
#	record of its own there, because the client key of a record
#	takes the oracle index (KEY-CLIENT-1).
sub _instance ( $self, $oracle )
{
	die "the harness holds no oracle $oracle\n" if $oracle < 1;
	return $self->{instance}[ ( $oracle - 1 ) % @{ $self->{instance} } ];
}

# $cp->records_at_start:
#	The count of the records that the store of the first instance
#	held when this run started it (TEST-MASK-6).
sub records_at_start ($self) { return $self->_instance(1)->{records_at_start} }

# $cp->records($oracle):
#	The record file names that the store of one instance holds
#	now. The default is the first one. A leg reads the set
#	before a step and after it, and the difference is the
#	records of that step (ORC-REVOKE-6).
sub records ( $self, $oracle = 1 )
{
	my $in = $self->_instance($oracle);
	return $self->{recipe}{records}->( $self, $in );
}

# $cp->wipe($oracle, $name):
#	Remove the record file $name from the store of one instance
#	(REC-WIPE-6). $name is one name of records($oracle). The leg
#	proves that a wiped record blocks no reveal while two records
#	remain.
sub wipe ( $self, $oracle, $name )
{
	my $in = $self->_instance($oracle);
	$self->{recipe}{wipe}->( $self, $in, $name );
	return;
}

# $cp->url($oracle), $cp->pubkey($oracle):
#	The URL and the static public key of one instance. The
#	default is the first one. A ceremony report names the oracle
#	of a failed enrollment with the URL (CER-CREATE-6).
sub url ( $self, $oracle = 1 ) { return $self->_instance($oracle)->{url} }

sub pubkey ( $self, $oracle = 1 )
{
	return $self->_instance($oracle)->{pubkey};
}

# $cp->foreign_key:
#	A valid static public key that this counterparty does not
#	hold (ORC-PROVISION-1).
sub foreign_key ($) { return $main::FOREIGN_POINT }

# $cp->master, $cp->plate_check:
#	The fixed test master, and the plate check value of it
#	(TEST-KAT-4, KEY-MASTER-5). The scan double prints the
#	master, so a ceremony of a leg runs under it.
sub master ($) { return $main::VECTOR{KAT_TEST_MASTER} }
sub plate_check ($) { return $main::VECTOR{KAT_TEST_PLATE_CHECK} }

# $cp->high_counter:
#	A stored counter above the wall clock (ORC-COUNTER-1).
sub high_counter ($) { return $main::HIGH_COUNTER }

# $cp->answer($name):
#	The value of the answer $name. A step of console() names an
#	answer, and a leg proves the secret of that step on the
#	terminal with this value (PROG-OUTPUT-1).
sub answer ( $, $name )
{
	die "the harness holds no answer $name\n"
	    if !exists $main::ANSWER{$name};
	return $main::ANSWER{$name};
}

# $cp->record($vault, %opt), $cp->canary_record($vault, %opt):
#	The two record names of the counters file (ORC-COUNTER-2,
#	VAULT-FORMAT). %opt takes 'slot' and 'oracle', and each one
#	replaces the slot of the vault and the first position.
sub record ( $, $vault, %opt )
{
	return ( $opt{slot} // $vault->{slot} ) . '-'
	    . ( $opt{oracle} // $main::ORACLE );
}

sub canary_record ( $, $, %opt )
{
	return 'canary-' . ( $opt{oracle} // $main::ORACLE );
}

# $cp->counters($vault), $cp->wrap($vault, %opt),
# $cp->index_wrap($vault, %opt), $cp->seal($vault, %opt):
#	The machine-local files of a record: the counters file, the
#	wrap of a slot, the index wrap, and the canary check seal
#	(VAULT-LAYOUT). %opt takes 'slot' and 'oracle' as above.
sub counters ( $, $vault ) { return "$vault->{dir}/machine/counters" }

sub wrap ( $, $vault, %opt )
{
	return "$vault->{dir}/machine/wrap."
	    . ( $opt{slot} // $vault->{slot} ) . '.'
	    . ( $opt{oracle} // $main::ORACLE );
}

sub index_wrap ( $, $vault, %opt )
{
	return "$vault->{dir}/machine/wrap.index."
	    . ( $opt{oracle} // $main::ORACLE );
}

sub seal ( $, $vault, %opt )
{
	return "$vault->{dir}/machine/canary."
	    . ( $opt{oracle} // $main::ORACLE );
}

# $cp->vault($tag, %opt):
#	A vault of the guest, with the config of the oracle set
#	(VAULT-CONFIG-1, ORC-PROVISION-1). The call gives a hash
#	with 'dir', the directory, and 'slot', the slot index of the
#	record. Each vault of a run takes the next slot index, so a
#	vault addresses a record of its own at the counterparty.
#
#	%opt takes 'pubkey' and 'url', and each one replaces the
#	provisioned value of every position.
sub vault ( $self, $tag, %opt )
{
	my $vault = $self->_empty( $tag, %opt, machine => $main::MACHINE );
	$self->config( $vault, %opt );
	return $vault;
}

# $cp->_empty($tag, %opt):
#	An empty vault directory of the guest, with no file in it.
#	%opt takes 'machine', the machine name of the vault, and
#	'slot', the slot index of the record. It also takes 'oracles',
#	the positions of the oracle set, 'threshold', the k of it, and
#	'pool', the slots of a ceremony. The machine name and the test
#	master give the device factor, so two vaults of one machine
#	name address one record of a slot (KEY-DEVICE-1).
sub _empty ( $self, $tag, %opt )
{
	my $slot = $self->{next_slot} //= $main::SLOT;
	$self->{next_slot}++;

	my $dir = "$main::WORK/vault/$self->{name}-$tag";
	main::guest_ok( "the vault $tag",
		'rm -rf ' . main::_shq($dir) . ' && mkdir -p '
		    . main::_shq("$main::WORK/vault") );
	return {
		dir       => $dir,
		slot      => $opt{slot} // $slot,
		tag       => $tag,
		machine   => $opt{machine} // $main::MACHINE,
		oracles   => $opt{oracles} // 1,
		threshold => $opt{threshold} // 1,
		pool      => $opt{pool} };
}

# $cp->config($vault, %opt):
#	The config file of the vault $vault, with one instance of
#	this counterparty at each position of the oracle set
#	(VAULT-CONFIG-1, ORC-PROVISION-1). %opt takes 'pubkey' and
#	'url', and each one replaces the provisioned value of every
#	position.
sub config ( $self, $vault, %opt )
{
	my @line;
	for my $oracle ( 1 .. $vault->{oracles} ) {
		push @line, "oracle-$oracle: "
		    . ( $opt{pubkey} // $self->pubkey($oracle) ) . ' '
		    . ( $opt{url}    // $self->url($oracle) );
	}
	push @line,
	    "threshold: $vault->{threshold}",
	    "machine-name: $vault->{machine}",
	    "kdf-rounds: $main::ROUNDS";

	main::guest_ok(
		"the config of $vault->{tag}",
		'mkdir -p '
		    . main::_shq("$vault->{dir}/machine")
		    . " && printf '%s\\n' "
		    . join( ' ', map { main::_shq($_) } @line )
		    . ' > '
		    . main::_shq("$vault->{dir}/machine/config") );
	return;
}

# $cp->ceremony_vault($tag, %opt):
#	An empty vault directory for a ceremony. The ceremony writes
#	the config file itself, so this call writes no file
#	(CER-CREATE-3). The machine name of the vault is the tag, so
#	two ceremony vaults of one run address no common record.
#
#	%opt takes the keys of _empty(): 'slot', 'oracles',
#	'threshold' and 'pool'.
sub ceremony_vault ( $self, $tag, %opt )
{
	return $self->_empty( $tag, %opt, machine => "create-$tag" );
}

# $cp->enroll($vault, %opt), $cp->reveal($vault, %opt),
# $cp->canary($vault, %opt):
#	One call of the driver. The hash of the call holds 'state',
#	the first word of the answer line, and 'share' and 'mask',
#	the two hex fields of a reveal. It also holds 'line', the
#	whole answer line, 'exit', the exit code of the driver, and
#	'error', the standard error of it.
#
#	%opt takes 'pass', an array reference of passphrase names.
#	The default is the correct passphrase. A canary enrollment
#	reads the passphrase twice (ORC-CANARY-6). Each call also
#	takes 'oracle', and enroll() and reveal() take 'slot': each
#	one replaces the first position and the slot of the vault. A
#	second enrollment of one record enrolls it under the pin of
#	that call (ORC-ENROLL-9).
sub enroll ( $self, $vault, %opt )
{
	return $self->_drive(
		[
			'enroll', $vault->{dir},
			$opt{oracle} // $main::ORACLE,
			$opt{slot}   // $vault->{slot}
		],
		$opt{pass} // ['right'] );
}

sub reveal ( $self, $vault, %opt )
{
	return $self->_drive(
		[
			'reveal', $vault->{dir},
			$opt{oracle} // $main::ORACLE,
			$opt{slot}   // $vault->{slot}
		],
		$opt{pass} // ['right'] );
}

sub canary ( $self, $vault, %opt )
{
	return $self->_drive(
		[ 'canary', $vault->{dir}, $opt{oracle} // $main::ORACLE ],
		$opt{pass} // [ 'right', 'right' ] );
}

# $cp->lock($vault, %opt):
#	One lock of the driver: the one wrong attempt of a revocation
#	at the revocation counter (ORC-REVOKE-8, TEST-HARNESS-3). The
#	driver reads no passphrase for it. %opt takes 'slot' and
#	'oracle', as enroll() takes them.
sub lock ( $self, $vault, %opt )
{
	return $self->_drive(
		[
			'lock', $vault->{dir},
			$opt{oracle} // $main::ORACLE,
			$opt{slot}   // $vault->{slot}
		],
		[] );
}

sub _drive ( $self, $argv, $names )
{
	my @lines;
	for my $name (@$names) {
		die "the harness holds no answer $name\n"
		    if !exists $main::ANSWER{$name};
		push @lines, $main::ANSWER{$name};
	}

	# fuguvm gives the guest no standard input, so the shell of
	# the guest writes the passphrase lines into the driver. The
	# status of a pipeline is the status of the last command, so
	# the exit code is the exit code of the driver.
	my $script =
	    "printf '%s\\n' "
	    . join( ' ', map { main::_shq($_) } @lines ) . ' | '
	    . join( ' ', map { main::_shq($_) } ( $main::DRIVER, @$argv ) );

	my $result = main::guest($script);
	my $line   = $result->{stdout} // '';
	chomp $line;
	my ( $state, $share, $mask ) = split ' ', $line;
	return {
		state => $state,
		share => $share,
		mask  => $mask,
		line  => $line,
		exit  => $result->{exit_code} // -1,
		error => $result->{stderr} // ''
	};
}

# $cp->read_file($path), $cp->write_file($path, @lines),
# $cp->file_exists($path), $cp->remove_file($path):
#	The files of a vault, in the guest. read_file() gives the
#	text of a file, or undef. write_file() writes one line for
#	each element. file_exists() reports the file, and
#	remove_file() removes it.
sub read_file ( $, $path )
{
	my $result = main::guest( 'cat ' . main::_shq($path) );
	return ( $result->{exit_code} // -1 ) == 0
	    ? $result->{stdout}
	    : undef;
}

sub write_file ( $, $path, @lines )
{
	main::guest_ok(
		"the file $path",
		"printf '%s\\n' "
		    . join( ' ', map { main::_shq($_) } @lines ) . ' > '
		    . main::_shq($path) );
	return;
}

sub file_exists ( $, $path )
{
	my $result = main::guest( 'test -e ' . main::_shq($path) );
	return ( $result->{exit_code} // -1 ) == 0 ? 1 : 0;
}

# $cp->remove_file(@path):
#	The files @path of the guest, removed in one call.
sub remove_file ( $, @path )
{
	main::guest_ok( "the removal of $path[0]",
		'rm -f ' . join( ' ', map { main::_shq($_) } @path ) );
	return;
}

# $cp->make_dir($path):
#	A directory of the guest at the path $path. A leg puts one
#	where a file of a vault belongs, so the write of that file
#	fails at the rename (VAULT-ATOMIC-2).
sub make_dir ( $, $path )
{
	main::guest_ok( "the directory $path",
		'mkdir -p ' . main::_shq($path) );
	return;
}

# $cp->copy_file($from, $to):
#	The file $from of the guest, at the path $to. A leg replaces
#	one wrap of a slot with the wrap of an other slot, and the
#	share of that oracle is then stale (ORC-QUORUM-4).
sub copy_file ( $, $from, $to )
{
	main::guest_ok( "the copy of $from",
		'cp ' . main::_shq($from) . ' ' . main::_shq($to) );
	return;
}

# $cp->copy_dir($from, $to):
#	The directory $from of the guest, at the path $to. A leg
#	builds the state of a ceremony in a copy of a vault, such as
#	the retirement of one position (CER-PROVISION-16).
sub copy_dir ( $, $from, $to )
{
	main::guest_ok( "the copy of $from",
		'rm -rf ' . main::_shq($to) . ' && cp -R '
		    . main::_shq($from) . ' ' . main::_shq($to) );
	return;
}

# $cp->copy_shared($from, $to):
#	The shared set of the vault directory $from of the guest,
#	into the vault directory $to: the index, and each entry or
#	slot file (VAULT-LAYOUT-3). The machine-local set stays
#	behind, so $to is a second machine of the vault
#	(CER-PROVISION-2, VAULT-BACKUP-2). The name of an entry file
#	is the hex of a hash, and the glob takes each one. The call
#	makes $to, because the core process makes a vault directory
#	at its first run alone.
sub copy_shared ( $, $from, $to )
{
	main::guest_ok( "the copy of the shared set of $from",
		'mkdir -p ' . main::_shq($to) . ' && cp '
		    . main::_shq("$from/index") . ' '
		    . main::_shq($from) . '/[0-9a-f]* '
		    . main::_shq($to) . '/' );
	return;
}

# $cp->digest($path):
#	The SHA-256 of the file $path of the guest, in lowercase hex,
#	and undef for an absent file. A leg holds two states of a
#	binary file apart with it, because read_file() carries text.
sub digest ( $, $path )
{
	my $result = main::guest( 'sha256 -q ' . main::_shq($path) );
	return undef if ( $result->{exit_code} // -1 ) != 0;
	my $hex = $result->{stdout} // '';
	chomp $hex;
	return $hex;
}

# $cp->names($dir):
#	The file names of the directory $dir of the guest, without
#	the path. An absent directory gives the empty list.
sub names ( $, $dir )
{
	my $result = main::guest( 'ls -1 ' . main::_shq($dir) );
	return () if ( $result->{exit_code} // -1 ) != 0;
	return grep { length } split /\n/, $result->{stdout} // '';
}

# $cp->search($dir, $text):
#	The paths under $dir of the guest that hold the bytes $text.
#	The search reads every file, and it takes $text as a fixed
#	string.
sub search ( $, $dir, $text )
{
	my $result = main::guest( 'grep -r -l -F -e '
		. main::_shq($text) . ' '
		. main::_shq($dir) );
	return grep { length } split /\n/, $result->{stdout} // '';
}

# $cp->program(@argv), $cp->real_program(@argv):
#	One run of the core process in the guest, with no terminal.
#	The hash of the call holds 'exit', 'out' and 'error'. A
#	subcommand that reads the passphrase needs a terminal, so
#	that one takes $cp->create().
#
#	real_program() runs the real scan helper in place of the
#	double (PROG-SPLIT-11). A ceremony of that call opens a video
#	device, and a machine with no camera stops at that open
#	(PROG-SCAN-7).
sub program ( $self, @argv ) { return $self->_program( undef, @argv ) }

sub real_program ( $self, @argv )
{
	return $self->_program( $main::REAL, @argv );
}

sub _program ( $, $helpers, @argv )
{
	my $cmd = join ' ',
	    map { main::_shq($_) } ( $main::PROGRAM, @argv );
	$cmd = 'FUGUPASS_HELPERS=' . main::_shq($helpers) . " $cmd"
	    if defined $helpers;

	my $result = main::guest($cmd);
	return {
		exit  => $result->{exit_code} // -1,
		out   => $result->{stdout}    // '',
		error => $result->{stderr}    // '' };
}

# $cp->elapsed($run):
#	The seconds of one step of console(), from the guest clock
#	before it and after it. The value holds a fraction, because
#	$CLOCK reads a sub-second clock.
sub elapsed ( $, $run )
{
	my ( $from, $to ) = @{ $run->{clock} };
	return $to - $from;
}

# $cp->terminal($run):
#	The lines that one step of console() wrote to the terminal,
#	without the prompts of it (PROG-OUTPUT-1). A revealed secret
#	takes one line, and a step that reveals none gives the empty
#	list.
sub terminal ( $, $run )
{
	return grep {
		length
		    && !/\A(?:Passphrase|Passphrase again|Secret): \z/
	}
	    map { s/\r//gr } split /\n/, $run->{console} // '';
}

# $cp->helper($name):
#	The path of one helper program of the guest (PROG-SPLIT-11).
#	The core process runs the programs of that directory, and a
#	leg drives one of them on its own.
sub helper ( $, $name )
{
	return "$main::HELPERS/$name";
}

# $cp->perl($script, @argv):
#	One run of the Perl program $script of the guest tree, with
#	the arguments @argv and with no terminal. The path is
#	relative to the tree, so a leg names a file of the
#	repository.
#
#	The hash of the call holds 'exit', the exit status of the
#	shell, and 'out' and 'error', the two streams. A pledge
#	violation kills the process with SIGABRT, and the shell then
#	gives 134. The run sets the core size to zero, because the
#	dump of an aborted perl fills the guest (SEC-MEMORY-3).
sub perl ( $, $script, @argv )
{
	my $result = main::guest( 'ulimit -c 0; ' . join ' ',
		map { main::_shq($_) } ( 'perl', "$main::TREE/$script",
			@argv ) );
	return {
		exit  => $result->{exit_code} // -1,
		out   => $result->{stdout}    // '',
		error => $result->{stderr}    // '' };
}

# $cp->create($vault, %opt):
#	The vault creation ceremony in the vault $vault (CER-CREATE).
#	The hash of the call holds 'exit', the exit status of the
#	ceremony, and 'out' and 'error', the two streams of it.
#
#	%opt takes 'pass', an array reference of two passphrase
#	names. The default is the correct passphrase twice. It also
#	takes 'threshold', and the default is 1.
#
#	The ceremony reads the passphrase from /dev/tty, so it runs
#	on the serial console of the guest, under 'fuguvm expect'
#	(TEST-HARNESS-8). The script of the guest holds every other
#	byte of the run, and it writes the exit status to a file.
sub create ( $self, $vault, %opt )
{
	my @pass = @{ $opt{pass} // [ 'right', 'right' ] };
	die "a ceremony reads two passphrases\n" if @pass != 2;

	my @argv = (
		'create', '-k', $vault->{threshold},
		'-m',     $vault->{machine},
		'-r',     $main::ROUNDS );
	push @argv, '-p', $vault->{pool} if defined $vault->{pool};
	for my $oracle ( 1 .. $vault->{oracles} ) {
		push @argv,
		    $self->pubkey($oracle) . ' ' . $self->url($oracle);
	}

	my ($run) = $self->console( $vault,
		{ argv => \@argv, answers => \@pass } );
	return $run;
}

# $cp->provision($vault, %opt):
#	The machine provisioning ceremony in the vault $vault
#	(CER-PROVISION). The hash of the call holds 'exit', 'out' and
#	'error', as create() gives them, and the run goes over the
#	console as well (TEST-HARNESS-8).
#
#	%opt takes 'answers', an array reference of answer names for
#	the prompts of the run, and the default is the correct
#	passphrase twice. It takes 'machine', 'threshold' and
#	'rounds', and each one replaces the value of the vault or of
#	the run. The oracle set is the set of the vault, as create()
#	gives it.
sub provision ( $self, $vault, %opt )
{
	my @argv = (
		'provision', '-k', $opt{threshold} // $vault->{threshold},
		'-m', $opt{machine} // $vault->{machine},
		'-r', $opt{rounds} // $main::ROUNDS );
	for my $oracle ( 1 .. $vault->{oracles} ) {
		push @argv,
		    $self->pubkey($oracle) . ' ' . $self->url($oracle);
	}

	my ($run) = $self->console( $vault,
		{ argv => \@argv,
			answers => $opt{answers} // [ 'right', 'right' ] } );
	return $run;
}

# $cp->console($vault, @step):
#	The steps @step of the core process, in one console session
#	of the guest (TEST-HARNESS-8). Each step is a hash with
#	'argv', the arguments after the vault directory, and
#	'answers', the names of the answers that the terminal reads
#	of the step take.
#
#	A step of an interactive session also holds 'input', the
#	operator command lines of it, and 'hold', the seconds that
#	the standard input stays open and silent after those lines
#	(PROG-REPL-1). A step of either key takes its standard input
#	from a named pipe, and a writer of the guest shell fills that
#	pipe in the background. The step therefore ends with the core
#	process, and not with the writer, so the idle lock of a
#	session costs the seconds of the timeout and not the seconds
#	of 'hold' (PROG-REPL-7). A step of neither key keeps the
#	standard input of the console.
#
#	The call gives one hash for each step. 'exit' is the exit
#	status of the step, and 'out' and 'error' are the two streams
#	of it. 'console' is the console text of the step, and a
#	secret prints there (PROG-OUTPUT-1). 'counters' is the
#	counters file after the step, by record name (ORC-COUNTER-2),
#	and 'clock' is the guest time before the step and after it.
sub console ( $self, $vault, @step )
{
	my $base = "$main::RUN/$vault->{tag}-" . ++$vault->{batch};
	my @line = (
		"FUGUPASS_HELPERS=$main::HELPERS",
		'export FUGUPASS_HELPERS' );
	my ( @answer, $count );

	$count = 0;
	for my $step (@step) {
		$count++;
		push @answer, map { $main::ANSWER{$_}
			    // die "the harness holds no answer $_\n" }
		    @{ $step->{answers} // [] };

		my $at    = "$base.$count";
		my $stdin = q{};
		if ( defined $step->{input} || defined $step->{hold} ) {
			push @line, "rm -f $at.fifo", "mkfifo $at.fifo",
			    '{ ' . _writer($step) . "; } > $at.fifo &";
			$stdin = " < $at.fifo";
		}

		push @line,
		    "echo '$main::STEP_MARK $count'",
		    "$main::CLOCK > $at.clock",
		    join( ' ',
			map { main::_shq($_) }
			    ( $main::PROGRAM, '-d', $vault->{dir},
				@{ $step->{argv} } ) )
			. "$stdin > $at.out 2> $at.err",
		    "echo \$? > $at.status",
		    "$main::CLOCK >> $at.clock",
		    'cat ' . main::_shq( $self->counters($vault) )
			. " > $at.counters 2>/dev/null; :";
		push @line, "rm -f $at.fifo" if length $stdin;
	}
	die "a console session holds one step at least\n" if $count == 0;
	push @line, "echo '$main::STEP_MARK 0'";

	my $path = main::guest_script( "$vault->{tag}-$vault->{batch}.sh",
		@line );
	my $console = main::host_ok(
		"the console of $vault->{tag}",
		[
			$main::FUGUVM,           'expect',
			$main::EXPECT,           "sh $path",
			$main::CONSOLE_PASSWORD, "$main::STEP_MARK 0",
			@answer
		],
		timeout => $main::CONSOLE_TIMEOUT );

	my @chunk = split /\Q$main::STEP_MARK\E [0-9]+/, $console;
	shift @chunk;
	my %file = $self->_slurp($base);

	my @run;
	for my $i ( 1 .. $count ) {
		my $status = $file{"$base.$i.status"};
		die "the step $i of $vault->{tag} wrote no exit status. "
		    . "The console of it:\n$console"
		    if !defined $status || $status !~ /\A([0-9]+)\s*\z/;
		push @run, {
			exit     => $1 + 0,
			out      => $file{"$base.$i.out"}   // '',
			error    => $file{"$base.$i.err"}   // '',
			console  => $chunk[ $i - 1 ]        // '',
			counters => _counters( $file{"$base.$i.counters"} ),
			clock    => [ split ' ',
				$file{"$base.$i.clock"} // '' ] };
	}
	return @run;
}

# _writer($step):
#	The command list that fills the named pipe of one step: the
#	operator command lines of 'input', and then the seconds of
#	'hold'. A step of 'hold' alone gives a standard input that
#	stays open and sends nothing, and a step of 'input' alone
#	gives the end of the input after the last line.
sub _writer ($step)
{
	my @input = @{ $step->{input} // [] };
	my $hold  = $step->{hold}     // 0;

	die "the hold of a step is the count of the seconds\n"
	    if $hold !~ /\A[0-9]+\z/;

	my @cmd;
	push @cmd, "printf '%s\\n' "
	    . join ' ', map { main::_shq($_) } @input
	    if @input;
	push @cmd, "sleep $hold" if $hold;
	return @cmd ? join '; ', @cmd : ':';
}

# $cp->_slurp($base):
#	Every file of the guest whose name starts with $base, by
#	path. One command reads the whole set, because one call of
#	fuguvm ssh costs a second.
sub _slurp ( $, $base )
{
	my $text = main::guest_ok( "the files of $base",
		"for f in $base.*; do echo \"=== fugupass-file \$f\"; "
		    . 'cat "$f"; done' );
	my %file;
	my @part = split /=== fugupass-file (\S+)\n/, $text;
	shift @part;
	while ( @part >= 2 ) {
		my ( $path, $body ) = splice @part, 0, 2;
		$file{$path} = $body;
	}
	return %file;
}

# _counters($text):
#	The counters file $text, by record name (ORC-COUNTER-2). An
#	absent file gives the empty hash.
sub _counters ($text)
{
	my %counter;
	for my $line ( split /\n/, $text // '' ) {
		$counter{$1} = $2 if $line =~ /\A(\S+): ([0-9]+)\z/;
	}
	return \%counter;
}

package main;

END {
	for my $cp (@RUNNING) {
		eval { $cp->stop;    1 } or warn $@;
		eval { $cp->release; 1 } or warn $@;
	}
	@RUNNING = ();
}

my $root = Cwd::abs_path("$RealBin/..");
my @legs = load_legs();

# The probe of every counterparty comes before the build, so a run
# without a counterparty costs no build and states the reason at
# once.
my ( @available, @skipped );
for my $recipe (@COUNTERPARTY) {
	my $cp  = Counterparty->new($recipe);
	my $why = $cp->probe;
	if ( defined $why ) {
		push @skipped, "the counterparty $recipe->{name} did not "
		    . "run: $why";
		next;
	}
	push @available, $cp;
}

diag($_) for @skipped;
BAIL_OUT( 'no counterparty is available, and the harness tested nothing' )
    if !@available;

note("the guest build of $root");
build_guest($root);

for my $cp (@available) {
	push @RUNNING, $cp;
	$cp->start;
	note( 'the counterparty '
		. $cp->name
		. ' answers at '
		. join( ', ',
			map { $cp->url($_) . ' (' . $cp->pubkey($_) . ')' }
			    1 .. $INSTANCES ) );

	for my $leg (@legs) {
		subtest $cp->name . ": $leg->{name}" => sub {
			$leg->{run}->($cp);
		};
	}

	@RUNNING = grep { $_ ne $cp } @RUNNING;
	$cp->stop;
	$cp->release;
}

note( 'the counterparties of this run: '
	. join( ', ', map { $_->name } @available ) );
note($_) for @skipped;
done_testing();
