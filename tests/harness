# harness: run the record legs against every available counterparty.
#
# usage: make harness
#
# This program is the interop harness of TEST-HARNESS. It is no .t
# file, and make check never runs it: it needs a live counterparty
# and an OpenBSD guest. mk/local.mk holds the harness target, and
# that target is the one caller.
#
# The harness holds three parts. The first part builds the source in
# the guest, and it takes the driver src/regress/oracle-client of
# that build (TEST-HARNESS-7). The second part is the counterparty
# table below: one data record for each counterparty, with the
# probe, the start, the stop, the release and the record list of it
# (TEST-HARNESS-4, TEST-HARNESS-6). The third part is
# tests/harness.d, one file for each leg. A leg reads the
# counterparty through the methods of the Counterparty package
# alone, so no leg branches on the counterparty (TEST-HARNESS-4).
#
# The harness runs no shell on the host: each host command is a
# list, and Fugu::Process runs it (TEST-HARNESS-6). A guest command
# goes through 'fuguvm ssh -- sh -c <script>', because a guest step
# needs a redirect and a pipe. That argument vector is a list as
# well, and App::FuguVM::Remote quotes each word of it. fuguvm gives
# the guest no standard input, so the driver reads the passphrase
# from a pipe of the guest shell.
#
# A ceremony reads the passphrase from /dev/tty, and the ssh channel
# of fuguvm carries no terminal. A ceremony therefore runs on the
# serial console, under 'fuguvm expect' and the script
# tests/expect/create.exp (TEST-HARNESS-8). An expect script reports
# its own run alone, so the script of the guest writes the exit
# status of the ceremony to a file, and the harness reads that file
# over 'fuguvm ssh'.
#
# The plate scan of a ceremony takes the double
# tests/stubs/fugupass-scan.c, and that double prints the fixed test
# master. The unveil list of the core process holds each helper path
# with the x permission and no interpreter, so the double is a
# program, and the guest build compiles it (PROG-SPLIT-3). The core
# process reads the helper directory from FUGUPASS_HELPERS in a
# regress build alone, so the guest build runs
# 'make FUGUPASS_REGRESS=1' (PROG-SPLIT-11).
#
# The harness fails when no counterparty is available. A pass over
# zero legs is no pass.
#
# The harness builds the tree of HEAD in the guest, and it runs the
# legs of the working tree. git status of src and tests must
# therefore report no change, and no untracked file. A local build
# leaves an obj directory that no ignore rule covers, so remove it
# before a run.
#
# These are the environment variables:
#
#	FUGUPASS_BLIND_PIN_SERVER
#		The directory of a checkout of the upstream
#		blind_pin_server, with a Python environment at
#		venv of that directory. The name of the directory
#		must stay blind_pin_server, because the start
#		recipe imports that module. Build the environment
#		on Python 3.13: the pinned wallycore publishes no
#		wheel for Python 3.14, and a source build of it
#		needs autotools. The command is 'uv pip install
#		--require-hashes -r requirements.txt'. The
#		location of a checkout of a third-party server is
#		no design fact of FuguPass, so no document of
#		spec/ names this variable.
#
#	FUGUVM	The fuguvm command. The default is fuguvm of the
#		PATH. fuguvm needs the modules of FuguVM and the
#		agent socket of the guest, so the caller sets
#		PERL5LIB and SSH_AUTH_SOCK for it.
#
#	FUGUPASS_CONSOLE_PASSWORD
#		The root password of the console login of the
#		guest. The default is openbsd, the password of the
#		installer of fuguvm. An installation of the mode
#		expect generates a password of 32 characters and
#		keeps it in the state of the guest, so the operator
#		reads that value and gives it here. fuguvm gives no
#		command for it, and no status key holds it. The
#		password of a disposable test guest is no design
#		fact of FuguPass, so no document of spec/ names this
#		variable.
#
# The harness runs the legs against every available conforming
# counterparty (TEST-HARNESS-1). The upstream blind_pin_server is the
# one counterparty today (TEST-HARNESS-2). The FuguOracle leg is
# absent, and no FuguOracle service speaks HTTP. That leg needs a
# FuguOracle deployment, and it then becomes one entry of the
# counterparty table.

use v5.36;

use Cwd              qw(abs_path);
use File::Basename   qw(basename dirname);
use File::Path       qw(make_path remove_tree);
use File::Temp       ();
use FindBin          qw($RealBin);
use HTTP::Tiny       ();
use IO::Socket::INET ();
use Test::More;

use Fugu::Process;
use Fugu::Timeout;

# The legs read these values through the Counterparty package, so
# each one is a package variable of main.

# The work directory of the guest. It sits on /home, because the
# root partition of the guest holds a few hundred megabytes only,
# and a build of this tree fills it.
our $WORK = '/home/fugupass/harness';

# The tree of the guest build, the driver that it builds, and the
# core process that it builds.
our $TREE    = "$WORK/tree";
our $DRIVER  = "$TREE/src/regress/obj/oracle-client";
our $PROGRAM = "$TREE/src/fugupass/obj/fugupass";

# The directory of the helper doubles, and the run directory of one
# ceremony. FUGUPASS_HELPERS names the first one, and the three
# helper paths are that directory and the three file names
# (PROG-SPLIT-11).
our $HELPERS = "$WORK/helpers";
our $RUN     = "$WORK/run";

# The fixed values of a test vault: the first slot index, the
# 1-based position of the oracle list, the machine name of the
# config, and the round count of the pin secret. A small round count
# keeps the cost of a leg in the request, and not in the KDF.
#
# The client key of a record takes the device factor, the oracle
# index and the slot index (KEY-CLIENT-1). The device factor takes
# the fixed test master and the machine name, so two vaults of one
# slot address one record at the counterparty. Each vault of a run
# therefore takes the next slot index, and one leg destroys no
# record of another leg.
our $SLOT    = 7;
our $ORACLE  = 1;
our $MACHINE = 'testmachine';
our $ROUNDS  = 16;

# The string constants of tests/vectors/derive.h, by name. The scan
# double prints KAT_TEST_MASTER, so a ceremony of a leg runs under
# the fixed test master (TEST-KAT-4). The header is the one place
# that holds the value of each constant.
our %VECTOR = vectors("$RealBin/vectors/derive.h");

# The passphrases of the legs, by name. A leg names one of these
# keys, and it holds no passphrase of its own. Each value holds no
# single quote and no line feed, and _shq() guards that.
our %PASSPHRASE = (
	right => 'correct horse battery staple',
	wrong => 'wrong horse battery staple',
	other => 'other horse battery staple' );

# The generator point of secp256k1, in compressed form. It is a
# valid public key, and it is the static key of no oracle. A leg
# gives it to the config to state a wrong static key
# (ORC-PROVISION-1).
our $FOREIGN_POINT =
    '0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798';

# A stored counter above the wall clock, for the legs of the counter
# policy. The value stays below 0xFFFFFFFF, because the client sends
# the stored value plus one, and it never sends 0xFFFFFFFF
# (ORC-COUNTER-5).
our $HIGH_COUNTER = 4_000_000_000;

our $FUGUVM = $ENV{FUGUVM} // 'fuguvm';

# The expect script of a ceremony. fuguvm expect gives it the host
# and the port of the console first, and the script needs the
# execute bit (TEST-HARNESS-8).
our $EXPECT = "$RealBin/expect/create.exp";

# The root password of the console login of the guest.
our $CONSOLE_PASSWORD = $ENV{FUGUPASS_CONSOLE_PASSWORD} // 'openbsd';

# The seconds of one guest command, and of one build of the tree.
my $GUEST_TIMEOUT = 300;
my $BUILD_TIMEOUT = 1800;

# The seconds of one ceremony on the console. A ceremony enrolls one
# record for each slot of the pool. The expect script reads the same
# value from FUGUVM_TIMEOUT, and it gives up before this timeout.
our $CONSOLE_TIMEOUT = 1500;
$ENV{FUGUVM_TIMEOUT} = $CONSOLE_TIMEOUT - 60;

# The start recipe of the upstream server. The Python of the
# checkout runs this program, and the first argument is the record
# store of the run. flask_server() reads the private key, the public
# key and the pins directory of the working directory, so the
# program enters the store before it imports the module.
# Fugu::Process->spawn_command() sets no working directory, and a
# shell is not allowed, so the chdir lives here.
my $SERVER_PROGRAM = <<'PYTHON';
import os, sys
os.chdir(sys.argv[1])
from blind_pin_server.flaskserver import flask_server
flask_server().run(host=sys.argv[2], port=int(sys.argv[3]))
PYTHON

# The counterparties that this harness drives (TEST-HARNESS-2). Each
# record holds the name, the four steps of the run, and the record
# list of the store. probe() gives undef when the counterparty is
# available, and the reason when it is not. start() sets url, pubkey
# and records_at_start. records() gives the record file names of the
# store of the moment. A leg reads no member of this table.
my @COUNTERPARTY = (
	{
		name    => 'blind_pin_server',
		probe   => \&upstream_probe,
		start   => \&upstream_start,
		stop    => \&upstream_stop,
		release => \&upstream_release,
		records => \&upstream_records
	} );

# The counterparties that run now. The end block stops each one, so
# a die and a signal leave no server behind, and no record store.
my @RUNNING;

# vectors($path):
#	The string constants of the vector header $path, by name.
#	The header holds one #define of each constant, and a
#	constant of more than one line joins with a backslash. A
#	#define of another form takes no entry.
sub vectors ($path)
{
	open my $fh, '<', $path or die "the harness reads no $path: $!\n";
	my $text = do { local $/ = undef; <$fh> };
	close $fh;

	$text =~ s/\\\n//g;
	my %value;
	while ( $text =~ /^\#define\s+(\w+)\s+(.*)$/mg ) {
		my ( $name, $rest ) = ( $1, $2 );
		my @part = $rest =~ /"([^"]*)"/g;
		$value{$name} = join '', @part if @part;
	}
	die "$path holds no string constant\n" if !%value;
	return %value;
}

# _shq($word):
#	One word for the shell of the guest, in single quotes. The
#	word must hold no single quote and no line feed. A leg
#	writes a literal path and a named passphrase, so a word of
#	another shape is a programming error.
sub _shq ($word)
{
	die "the harness cannot quote the word $word\n" if $word =~ /['\n]/;
	return "'$word'";
}

# guest($script, $timeout):
#	Run one shell script in the guest, and give the result hash
#	of Fugu::Process->run(). The host command is a list, and the
#	script is one word of it.
sub guest ( $script, $timeout = $GUEST_TIMEOUT )
{
	return Fugu::Process->run(
		cmd     => [ $FUGUVM, 'ssh', '--', 'sh', '-c', $script ],
		timeout => $timeout );
}

# guest_script($name, @lines):
#	Write the shell script @lines to the run directory of the
#	guest, and give the path of it. The copy takes 'fuguvm put',
#	so a line needs no quoting for the shell of the guest.
sub guest_script ( $name, @lines )
{
	my $file = File::Temp->new(
		TEMPLATE => 'fugupass-script-XXXXXX',
		TMPDIR   => 1,
		SUFFIX   => '.sh' );
	print {$file} map { "$_\n" } @lines
	    or die "the harness wrote no script: $!\n";
	close $file or die "the harness closed no script: $!\n";

	my $path = "$RUN/$name";
	guest_ok( 'the run directory', "mkdir -p $RUN" );
	host_ok( 'fuguvm put', [ $FUGUVM, 'put', "$file", $path ],
		timeout => $GUEST_TIMEOUT );
	return $path;
}

# guest_ok($what, $script, $timeout):
#	Run one shell script in the guest, and die when it fails.
#	The call gives the standard output of the script, and $what
#	names the step in the message.
sub guest_ok ( $what, $script, $timeout = $GUEST_TIMEOUT )
{
	my $result = guest( $script, $timeout );
	return $result->{stdout} if ( $result->{exit_code} // -1 ) == 0;

	die "the guest failed at $what: "
	    . ( $result->{error} // 'exit ' . ( $result->{exit_code} // -1 ) )
	    . "\n$result->{stdout}$result->{stderr}";
}

# host_ok($what, $cmd, %args):
#	Run one host command, and die when it fails. %args goes to
#	Fugu::Process->run().
sub host_ok ( $what, $cmd, %args )
{
	my $result = Fugu::Process->run( cmd => $cmd, %args );
	return $result->{stdout} if $result->{success};

	die "the host failed at $what: "
	    . ( $result->{error} // 'exit ' . ( $result->{exit_code} // -1 ) )
	    . "\n$result->{stdout}$result->{stderr}";
}

# free_port():
#	A TCP port that no program holds now. The guest reaches the
#	host at the QEMU gateway address, so a host counterparty
#	binds every address of the host (TEST-HARNESS-7).
sub free_port ()
{
	my $socket = IO::Socket::INET->new(
		Listen    => 1,
		LocalAddr => '127.0.0.1',
		Proto     => 'tcp'
	) or die "the host holds no free port: $!\n";
	my $port = $socket->sockport;
	$socket->close;
	return $port;
}

# build_guest($root):
#	Build the source of the checkout $root in the guest, and
#	leave the driver at $DRIVER (TEST-HARNESS-7).
#
#	git archive writes the committed tree of src and tests, so
#	the copy needs no file list. A hand-written list of files
#	goes stale, and a stale list hides a defect behind a green
#	gate.
#
#	The build therefore takes HEAD, and load_legs() takes the
#	legs of the working tree. One tree must be under test, so a
#	change of src or tests that no commit holds stops the run.
sub build_guest ($root)
{
	my $dirty = host_ok(
		'git status',
		[ 'git', 'status', '--porcelain', '--', 'src', 'tests' ],
		cwd     => $root,
		timeout => $GUEST_TIMEOUT );
	die "the harness builds HEAD, and src or tests holds a change "
	    . "that no commit holds. Commit the change, or remove the "
	    . "file. An untracked file counts, and no ignore rule "
	    . "covers the obj directory of a build:\n$dirty"
	    if $dirty =~ /\S/;

	my $tar = File::Temp->new(
		TEMPLATE => 'fugupass-tree-XXXXXX',
		TMPDIR   => 1,
		SUFFIX   => '.tar'
	);
	host_ok(
		'git archive',
		[
			'git', 'archive', '--format=tar', '-o', "$tar",
			'HEAD', 'src', 'tests'
		],
		cwd     => $root,
		timeout => $GUEST_TIMEOUT );

	guest_ok( 'the work directory', "rm -rf $WORK && mkdir -p $TREE" );
	host_ok(
		'fuguvm put',
		[ $FUGUVM, 'put', "$tar", "$WORK/tree.tar" ],
		timeout => $GUEST_TIMEOUT );
	guest_ok( 'the unpack', "cd $TREE && tar xf $WORK/tree.tar" );
	guest_ok( 'the build',
		"cd $TREE/src && make obj && make FUGUPASS_REGRESS=1",
		$BUILD_TIMEOUT );
	guest_ok( 'the driver',  "test -x $DRIVER" );
	guest_ok( 'the program', "test -x $PROGRAM" );

	# The scan double of the ceremony legs. The core process
	# runs it from the directory that FUGUPASS_HELPERS names,
	# and it reads the vectors of the tree above.
	guest_ok(
		'the scan double',
		"mkdir -p $HELPERS $RUN && cc -Wall -Wextra -Werror "
		    . "-I$TREE/tests -o $HELPERS/fugupass-scan "
		    . "$TREE/tests/stubs/fugupass-scan.c" );
	return;
}

# load_legs():
#	The legs of tests/harness.d, in the order of the file name.
#	Each file returns one code reference, and the harness calls
#	it once for each counterparty. A directory without a leg is
#	a failure: the harness must not pass over zero legs.
sub load_legs ()
{
	my @legs;
	for my $file ( sort glob "$RealBin/harness.d/*.pl" ) {
		my $run = do $file;
		die "$file returns no leg: $@$!\n" if ref $run ne 'CODE';
		my $name = basename( $file, '.pl' );
		$name =~ s/\A[0-9]+-//;
		push @legs, { name => $name, run => $run };
	}
	die "tests/harness.d holds no leg\n" if !@legs;
	return @legs;
}

#
# The upstream Python counterparty. It runs on the host, and the
# client of the guest reaches it at the QEMU gateway address
# (TEST-HARNESS-7).
#

# upstream_python($checkout):
#	The interpreter and the environment of the checkout. The
#	module name is blind_pin_server, so PYTHONPATH names the
#	directory above the checkout. The child writes no byte code,
#	because the checkout belongs to the operator.
sub upstream_python ($checkout)
{
	return (
		"$checkout/venv/bin/python",
		{
			PATH                    => '/usr/bin:/bin',
			HOME                    => $ENV{HOME} // '/',
			PYTHONPATH              => dirname($checkout),
			PYTHONDONTWRITEBYTECODE => '1'
		} );
}

sub upstream_probe ($cp)
{
	my $checkout = $ENV{FUGUPASS_BLIND_PIN_SERVER};
	return 'FUGUPASS_BLIND_PIN_SERVER names no directory'
	    if !defined $checkout || !-d $checkout;
	return "$checkout does not carry the name blind_pin_server"
	    if basename($checkout) ne 'blind_pin_server';
	return "$checkout holds no flaskserver.py"
	    if !-f "$checkout/flaskserver.py";
	return "$checkout/venv/bin/python is no program"
	    if !-x "$checkout/venv/bin/python";

	my ( $python, $env ) = upstream_python($checkout);
	my $result = Fugu::Process->run(
		cmd     => [ $python, '-c', 'import flask, wallycore' ],
		env     => $env,
		timeout => 120 );
	return "$checkout/venv holds no flask and no wallycore"
	    if !$result->{success};

	$cp->{checkout} = $checkout;
	return undef;
}

sub upstream_start ($cp)
{
	my ( $python, $env ) = upstream_python( $cp->{checkout} );

	if ( !defined $cp->{store} ) {

		# The record store of the run (TEST-HARNESS-6,
		# TEST-MASK-6). pindb.py takes the store from the
		# pins directory of the working directory, and the
		# server reads its static key from that directory
		# as well.
		$cp->{store} = File::Temp::tempdir(
			'fugupass-oracle-XXXXXX',
			TMPDIR  => 1,
			CLEANUP => 0
		);
		make_path("$cp->{store}/pins");
		$cp->{port} = free_port();
		$cp->{url}  = "http://10.0.2.2:$cp->{port}";

		# generateserverkey writes the key pair at mode
		# 0600 in the working directory, and the server
		# refuses a key that another user can read.
		host_ok(
			'generateserverkey',
			[
				$python, '-m',
				'blind_pin_server.generateserverkey'
			],
			cwd     => $cp->{store},
			env     => $env,
			timeout => 120 );

		open my $fh, '<:raw', "$cp->{store}/server_public_key.pub"
		    or die "the server wrote no public key: $!\n";
		my $bytes = do { local $/ = undef; <$fh> };
		close $fh;
		$cp->{pubkey} = unpack 'H*', $bytes;
	}

	# Each stream of each run takes a path of its own. Two
	# handles on one path overwrite each other, and 3-states.pl
	# restarts the server.
	my $log = "$cp->{store}/server-" . ++$cp->{runs};
	my $result = Fugu::Process->spawn_command(
		cmd => [
			$python,      '-c', $SERVER_PROGRAM, $cp->{store},
			'0.0.0.0', $cp->{port}
		],
		env    => $env,
		stdout => "$log.out",
		stderr => "$log.err" );
	die "the upstream server did not start: $result->{error}\n"
	    if !$result->{success};
	$cp->{pid} = $result->{pid};

	my $http = HTTP::Tiny->new( timeout => 5 );
	Fugu::Timeout::wait_until(
		60, 0.25,
		sub {
			return $http->get("http://127.0.0.1:$cp->{port}/")
			    ->{status} == 200;
		} )
	    or die "the upstream server never answered on port "
	    . "$cp->{port}\n";

	$cp->{records_at_start} //= scalar( () = upstream_records($cp) );
	return;
}

# upstream_records($cp):
#	The record file names of the store of this counterparty.
#	pindb.py of the upstream server holds one file of each
#	record in the pins directory of the store.
sub upstream_records ($cp)
{
	return map { basename($_) } glob "$cp->{store}/pins/*.pin";
}

sub upstream_stop ($cp)
{
	return if !defined $cp->{pid};
	Fugu::Process->terminate( delete $cp->{pid} );
	return;
}

sub upstream_release ($cp)
{
	return if !defined $cp->{store};
	remove_tree( delete $cp->{store} );
	return;
}

package Counterparty;

# The counterparty of one run. A leg reads it through these methods
# alone, so no leg branches on the counterparty (TEST-HARNESS-4).
# The record of the table holds the four steps and the record list,
# and the object holds the state of the run: the URL, the static
# public key, and the record count of the store at the start.

use v5.36;

sub new ( $class, $recipe )
{
	return bless { recipe => $recipe, name => $recipe->{name} }, $class;
}

sub name ($self) { return $self->{name} }

sub probe ($self)   { return $self->{recipe}{probe}->($self) }
sub start ($self)   { $self->{recipe}{start}->($self); return }
sub stop ($self)    { $self->{recipe}{stop}->($self); return }
sub release ($self) { $self->{recipe}{release}->($self); return }

# $cp->records_at_start:
#	The count of the records that the store of the counterparty
#	held when this run started it (TEST-MASK-6).
sub records_at_start ($self) { return $self->{records_at_start} }

# $cp->records:
#	The record file names that the store of the counterparty
#	holds now. A leg reads the set before a step and after it,
#	and the difference is the records of that step
#	(ORC-REVOKE-6).
sub records ($self) { return $self->{recipe}{records}->($self) }

# $cp->url:
#	The URL of this counterparty. A ceremony report names the
#	oracle of a failed enrollment with it (CER-CREATE-6).
sub url ($self) { return $self->{url} }

# $cp->foreign_key:
#	A valid static public key that this counterparty does not
#	hold (ORC-PROVISION-1).
sub foreign_key ($) { return $main::FOREIGN_POINT }

# $cp->master, $cp->plate_check:
#	The fixed test master, and the plate check value of it
#	(TEST-KAT-4, KEY-MASTER-5). The scan double prints the
#	master, so a ceremony of a leg runs under it.
sub master ($) { return $main::VECTOR{KAT_TEST_MASTER} }
sub plate_check ($) { return $main::VECTOR{KAT_TEST_PLATE_CHECK} }

# $cp->high_counter:
#	A stored counter above the wall clock (ORC-COUNTER-1).
sub high_counter ($) { return $main::HIGH_COUNTER }

# $cp->record($vault), $cp->canary_record($vault):
#	The two record names of the counters file (ORC-COUNTER-2,
#	VAULT-FORMAT).
sub record ( $, $vault ) { return "$vault->{slot}-$main::ORACLE" }
sub canary_record ( $, $ ) { return "canary-$main::ORACLE" }

# $cp->counters($vault), $cp->wrap($vault), $cp->seal($vault):
#	The three machine-local files of a record: the counters
#	file, the wrap of the slot, and the canary check seal
#	(VAULT-LAYOUT).
sub counters ( $, $vault ) { return "$vault->{dir}/machine/counters" }

sub wrap ( $, $vault )
{
	return "$vault->{dir}/machine/wrap.$vault->{slot}.$main::ORACLE";
}

sub seal ( $, $vault ) { return "$vault->{dir}/machine/canary.$main::ORACLE" }

# $cp->vault($tag, %opt):
#	A vault of the guest, with the config of one oracle
#	(VAULT-CONFIG-1, ORC-PROVISION-1). The call gives a hash
#	with 'dir', the directory, and 'slot', the slot index of the
#	record. Each vault of a run takes the next slot index, so a
#	vault addresses a record of its own at the counterparty.
#
#	%opt takes 'pubkey' and 'url', and each one replaces the
#	provisioned value of the counterparty.
sub vault ( $self, $tag, %opt )
{
	my $vault = $self->_empty( $tag, machine => $main::MACHINE );
	$self->config( $vault, %opt );
	return $vault;
}

# $cp->_empty($tag, %opt):
#	An empty vault directory of the guest, with no file in it.
#	%opt takes 'machine', the machine name of the vault, and
#	'slot', the slot index of the record. The machine name and
#	the test master give the device factor, so two vaults of one
#	machine name address one record of a slot (KEY-DEVICE-1).
sub _empty ( $self, $tag, %opt )
{
	my $slot = $self->{next_slot} //= $main::SLOT;
	$self->{next_slot}++;

	my $dir = "$main::WORK/vault/$self->{name}-$tag";
	main::guest_ok( "the vault $tag",
		'rm -rf ' . main::_shq($dir) . ' && mkdir -p '
		    . main::_shq("$main::WORK/vault") );
	return {
		dir     => $dir,
		slot    => $opt{slot} // $slot,
		tag     => $tag,
		machine => $opt{machine} // $main::MACHINE };
}

# $cp->config($vault, %opt):
#	The config file of the vault $vault, with the one oracle of
#	this counterparty at position 1 (VAULT-CONFIG-1,
#	ORC-PROVISION-1). %opt takes 'pubkey' and 'url', and each one
#	replaces the provisioned value of the counterparty.
sub config ( $self, $vault, %opt )
{
	my $pubkey = $opt{pubkey} // $self->{pubkey};
	my $url    = $opt{url}    // $self->{url};

	main::guest_ok(
		"the config of $vault->{tag}",
		'mkdir -p '
		    . main::_shq("$vault->{dir}/machine")
		    . " && printf '%s\\n' "
		    . join( ' ',
			map { main::_shq($_) } (
				"oracle-1: $pubkey $url",
				'threshold: 1',
				"machine-name: $vault->{machine}",
				"kdf-rounds: $main::ROUNDS" ) )
		    . ' > '
		    . main::_shq("$vault->{dir}/machine/config") );
	return;
}

# $cp->ceremony_vault($tag, %opt):
#	An empty vault directory for a ceremony. The ceremony writes
#	the config file itself, so this call writes no file
#	(CER-CREATE-3). The machine name of the vault is the tag, so
#	two ceremony vaults of one run address no common record.
#
#	%opt takes 'slot', the slot index that the counters methods
#	then name.
sub ceremony_vault ( $self, $tag, %opt )
{
	return $self->_empty( $tag, %opt, machine => "create-$tag" );
}

# $cp->enroll($vault, %opt), $cp->reveal($vault, %opt),
# $cp->canary($vault, %opt):
#	One call of the driver. The hash of the call holds 'state',
#	the first word of the answer line, and 'share' and 'mask',
#	the two hex fields of a reveal. It also holds 'line', the
#	whole answer line, 'exit', the exit code of the driver, and
#	'error', the standard error of it.
#
#	%opt takes 'pass', an array reference of passphrase names.
#	The default is the correct passphrase. A canary enrollment
#	reads the passphrase twice (ORC-CANARY-6).
sub enroll ( $self, $vault, %opt )
{
	return $self->_drive(
		[ 'enroll', $vault->{dir}, $main::ORACLE, $vault->{slot} ],
		$opt{pass} // ['right'] );
}

sub reveal ( $self, $vault, %opt )
{
	return $self->_drive(
		[ 'reveal', $vault->{dir}, $main::ORACLE, $vault->{slot} ],
		$opt{pass} // ['right'] );
}

sub canary ( $self, $vault, %opt )
{
	return $self->_drive( [ 'canary', $vault->{dir}, $main::ORACLE ],
		$opt{pass} // [ 'right', 'right' ] );
}

sub _drive ( $self, $argv, $names )
{
	my @lines;
	for my $name (@$names) {
		die "the harness holds no passphrase $name\n"
		    if !exists $main::PASSPHRASE{$name};
		push @lines, $main::PASSPHRASE{$name};
	}

	# fuguvm gives the guest no standard input, so the shell of
	# the guest writes the passphrase lines into the driver. The
	# status of a pipeline is the status of the last command, so
	# the exit code is the exit code of the driver.
	my $script =
	    "printf '%s\\n' "
	    . join( ' ', map { main::_shq($_) } @lines ) . ' | '
	    . join( ' ', map { main::_shq($_) } ( $main::DRIVER, @$argv ) );

	my $result = main::guest($script);
	my $line   = $result->{stdout} // '';
	chomp $line;
	my ( $state, $share, $mask ) = split ' ', $line;
	return {
		state => $state,
		share => $share,
		mask  => $mask,
		line  => $line,
		exit  => $result->{exit_code} // -1,
		error => $result->{stderr} // ''
	};
}

# $cp->read_file($path), $cp->write_file($path, @lines),
# $cp->file_exists($path), $cp->remove_file($path):
#	The files of a vault, in the guest. read_file() gives the
#	text of a file, or undef. write_file() writes one line for
#	each element. file_exists() reports the file, and
#	remove_file() removes it.
sub read_file ( $, $path )
{
	my $result = main::guest( 'cat ' . main::_shq($path) );
	return ( $result->{exit_code} // -1 ) == 0
	    ? $result->{stdout}
	    : undef;
}

sub write_file ( $, $path, @lines )
{
	main::guest_ok(
		"the file $path",
		"printf '%s\\n' "
		    . join( ' ', map { main::_shq($_) } @lines ) . ' > '
		    . main::_shq($path) );
	return;
}

sub file_exists ( $, $path )
{
	my $result = main::guest( 'test -e ' . main::_shq($path) );
	return ( $result->{exit_code} // -1 ) == 0 ? 1 : 0;
}

sub remove_file ( $, $path )
{
	main::guest_ok( "the removal of $path",
		'rm -f ' . main::_shq($path) );
	return;
}

# $cp->names($dir):
#	The file names of the directory $dir of the guest, without
#	the path. An absent directory gives the empty list.
sub names ( $, $dir )
{
	my $result = main::guest( 'ls -1 ' . main::_shq($dir) );
	return () if ( $result->{exit_code} // -1 ) != 0;
	return grep { length } split /\n/, $result->{stdout} // '';
}

# $cp->search($dir, $text):
#	The paths under $dir of the guest that hold the bytes $text.
#	The search reads every file, and it takes $text as a fixed
#	string.
sub search ( $, $dir, $text )
{
	my $result = main::guest( 'grep -r -l -F -e '
		. main::_shq($text) . ' '
		. main::_shq($dir) );
	return grep { length } split /\n/, $result->{stdout} // '';
}

# $cp->program(@argv):
#	One run of the core process in the guest, with no terminal.
#	The hash of the call holds 'exit', 'out' and 'error'. A
#	subcommand that reads the passphrase needs a terminal, so
#	that one takes $cp->create().
sub program ( $, @argv )
{
	my $result = main::guest(
		join ' ',
		map { main::_shq($_) } ( $main::PROGRAM, @argv ) );
	return {
		exit  => $result->{exit_code} // -1,
		out   => $result->{stdout}    // '',
		error => $result->{stderr}    // '' };
}

# $cp->create($vault, %opt):
#	The vault creation ceremony in the vault $vault (CER-CREATE).
#	The hash of the call holds 'exit', the exit status of the
#	ceremony, and 'out' and 'error', the two streams of it.
#
#	%opt takes 'pass', an array reference of two passphrase
#	names. The default is the correct passphrase twice. It also
#	takes 'threshold', and the default is 1.
#
#	The ceremony reads the passphrase from /dev/tty, so it runs
#	on the serial console of the guest, under 'fuguvm expect'
#	(TEST-HARNESS-8). The script of the guest holds every other
#	byte of the run, and it writes the exit status to a file.
sub create ( $self, $vault, %opt )
{
	my @pass = map { $main::PASSPHRASE{$_}
		    // die "the harness holds no passphrase $_\n" }
	    @{ $opt{pass} // [ 'right', 'right' ] };
	die "a ceremony reads two passphrases\n" if @pass != 2;

	my $base = "$main::RUN/$vault->{tag}";
	my $path = main::guest_script(
		"$vault->{tag}.sh",
		"FUGUPASS_HELPERS=$main::HELPERS",
		'export FUGUPASS_HELPERS',
		"$main::PROGRAM -d $vault->{dir} create "
		    . '-k ' . ( $opt{threshold} // 1 )
		    . " -m $vault->{machine} -r $main::ROUNDS "
		    . "'$self->{pubkey} $self->{url}' "
		    . "> $base.out 2> $base.err",
		"echo \$? > $base.status" );

	my $console = main::host_ok(
		"the ceremony $vault->{tag}",
		[
			$main::FUGUVM, 'expect', $main::EXPECT,
			"sh $path", @pass, $main::CONSOLE_PASSWORD
		],
		timeout => $main::CONSOLE_TIMEOUT );

	my $status = $self->read_file("$base.status");
	die "the ceremony $vault->{tag} wrote no exit status. The console "
	    . "of it:\n$console"
	    if !defined $status || $status !~ /\A([0-9]+)\s*\z/;
	return {
		exit  => $1 + 0,
		out   => $self->read_file("$base.out")   // '',
		error => $self->read_file("$base.err")   // '' };
}

package main;

END {
	for my $cp (@RUNNING) {
		eval { $cp->stop;    1 } or warn $@;
		eval { $cp->release; 1 } or warn $@;
	}
	@RUNNING = ();
}

my $root = Cwd::abs_path("$RealBin/..");
my @legs = load_legs();

# The probe of every counterparty comes before the build, so a run
# without a counterparty costs no build and states the reason at
# once.
my ( @available, @skipped );
for my $recipe (@COUNTERPARTY) {
	my $cp  = Counterparty->new($recipe);
	my $why = $cp->probe;
	if ( defined $why ) {
		push @skipped, "the counterparty $recipe->{name} did not "
		    . "run: $why";
		next;
	}
	push @available, $cp;
}

diag($_) for @skipped;
BAIL_OUT( 'no counterparty is available, and the harness tested nothing' )
    if !@available;

note("the guest build of $root");
build_guest($root);

for my $cp (@available) {
	push @RUNNING, $cp;
	$cp->start;
	note( 'the counterparty '
		. $cp->name
		. ' answers at '
		. $cp->{url}
		. ', with the static key '
		. $cp->{pubkey} );

	for my $leg (@legs) {
		subtest $cp->name . ": $leg->{name}" => sub {
			$leg->{run}->($cp);
		};
	}

	@RUNNING = grep { $_ ne $cp } @RUNNING;
	$cp->stop;
	$cp->release;
}

note( 'the counterparties of this run: '
	. join( ', ', map { $_->name } @available ) );
note($_) for @skipped;
done_testing();
